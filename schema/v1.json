{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/sharzilnfz/wt/schema/v1.json",
  "title": "WT Envelope v1 Schema",
  "description": "Authoritative JSON schema for the wt CLI v1 machine-readable output envelope and command payloads.",
  "type": "object",
  "required": [
    "wt_version",
    "schema_version",
    "command",
    "status",
    "data",
    "diagnostics"
  ],
  "properties": {
    "wt_version": {
      "type": "string",
      "description": "Cargo package version of the binary that generated this envelope."
    },
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Monotonically increasing integer version of this envelope contract."
    },
    "command": {
      "type": "string",
      "enum": [
        "create",
        "hydrate",
        "init",
        "clean",
        "remove",
        "sweep",
        "scrub",
        "store",
        "scratch",
        "list",
        "demo",
        "lease",
        "doctor"
      ],
      "description": "Canonical name of the invoked wt command."
    },
    "status": {
      "type": "string",
      "enum": ["ok", "error"],
      "description": "Overall outcome status of the operation."
    },
    "data": {
      "description": "Payload specific to the executed command, or null on error / empty output.",
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/definitions/CreateData" },
        { "$ref": "#/definitions/HydrateData" },
        { "$ref": "#/definitions/InitData" },
        { "$ref": "#/definitions/RemoveData" },
        { "$ref": "#/definitions/SweepData" },
        { "$ref": "#/definitions/ScrubData" },
        { "$ref": "#/definitions/MigrateData" },
        { "$ref": "#/definitions/ListData" },
        { "$ref": "#/definitions/ScratchData" },
        { "$ref": "#/definitions/DemoData" },
        { "$ref": "#/definitions/CleanData" },
        { "$ref": "#/definitions/LeaseData" },
        { "$ref": "#/definitions/DoctorData" },
        { "$ref": "#/definitions/StoreDuData" }
      ]
    },
    "diagnostics": {
      "type": "array",
      "description": "Structured diagnostics, warnings, and errors emitted during execution.",
      "items": {
        "$ref": "#/definitions/Diagnostic"
      }
    }
  },
  "definitions": {
    "Diagnostic": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "description": "Machine-readable uppercase diagnostic code."
        },
        "message": {
          "type": "string",
          "description": "Human-readable diagnostic explanation."
        },
        "level": {
          "type": "string",
          "enum": ["error", "warning", "info"],
          "description": "Severity level of the diagnostic."
        }
      },
      "additionalProperties": false
    },
    "CreateData": {
      "type": "object",
      "required": [
        "worktree_path",
        "branch",
        "cache_hit",
        "duration_ms",
        "hydration_method",
        "bytes_shared_cow",
        "bytes_copied",
        "files_hydrated"
      ],
      "properties": {
        "worktree_path": { "type": "string" },
        "branch": { "type": "string" },
        "cache_hit": { "type": "boolean" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "hydration_method": { "type": "string" },
        "bytes_shared_cow": { "type": "integer", "minimum": 0 },
        "bytes_copied": { "type": "integer", "minimum": 0 },
        "files_hydrated": { "type": "integer", "minimum": 0 },
        "incremental_decision": { "type": "string" },
        "incremental_fallback_reason": { "type": "string" },
        "incremental_hit_rate": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "copy_mechanism": { "type": "string" },
        "copy_fallback_reason": { "type": "string" },
        "resumed": { "type": "boolean" },
        "receipt_path": { "type": "string" }
      },
      "additionalProperties": false
    },
    "HydrateData": {
      "type": "object",
      "required": [
        "destination_path",
        "source_path",
        "cache_hit",
        "duration_ms",
        "hydration_method",
        "bytes_shared_cow",
        "bytes_copied",
        "files_hydrated",
        "dirs_hydrated"
      ],
      "properties": {
        "destination_path": { "type": "string" },
        "source_path": { "type": "string" },
        "cache_hit": { "type": "boolean" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "hydration_method": { "type": "string" },
        "bytes_shared_cow": { "type": "integer", "minimum": 0 },
        "bytes_copied": { "type": "integer", "minimum": 0 },
        "files_hydrated": { "type": "integer", "minimum": 0 },
        "dirs_hydrated": {
          "type": "array",
          "items": { "type": "string" }
        },
        "incremental_decision": { "type": "string" },
        "incremental_fallback_reason": { "type": "string" },
        "incremental_hit_rate": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "copy_mechanism": { "type": "string" },
        "copy_fallback_reason": { "type": "string" },
        "receipt_path": { "type": "string" }
      },
      "additionalProperties": false
    },
    "InitData": {
      "type": "object",
      "required": ["manifest_path", "created"],
      "properties": {
        "manifest_path": { "type": "string" },
        "created": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "RemoveData": {
      "type": "object",
      "required": [
        "worktree_path",
        "branch",
        "references_released",
        "mirror_removed"
      ],
      "properties": {
        "worktree_path": { "type": "string" },
        "branch": { "type": "string" },
        "references_released": { "type": "integer", "minimum": 0 },
        "mirror_removed": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "SweepData": {
      "type": "object",
      "required": ["mode", "examined", "reclaimed"],
      "properties": {
        "mode": { "type": "string" },
        "examined": { "type": "integer", "minimum": 0 },
        "reclaimed": { "type": "integer", "minimum": 0 },
        "mirrors_removed": { "type": "integer", "minimum": 0 },
        "snapshot_dirs_removed": { "type": "integer", "minimum": 0 },
        "snapshot_cap_evicted": { "type": "integer", "minimum": 0 },
        "deferred_by_grace": { "type": "boolean" },
        "leases_examined": { "type": "integer", "minimum": 0 },
        "leases_reclaimed": { "type": "integer", "minimum": 0 },
        "lease_bytes_reclaimed": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "ScrubData": {
      "type": "object",
      "required": ["dry_run", "scanned", "corrupt", "deleted"],
      "properties": {
        "dry_run": { "type": "boolean" },
        "scanned": { "type": "integer", "minimum": 0 },
        "corrupt": {
          "type": "array",
          "items": { "type": "string" }
        },
        "deleted": { "type": "integer", "minimum": 0 },
        "snapshot_dirs_scanned": { "type": "integer", "minimum": 0 },
        "corrupt_snapshots": {
          "type": "array",
          "items": { "type": "string" }
        },
        "snapshot_dirs_deleted": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "MigrateData": {
      "type": "object",
      "required": ["gc_mode"],
      "properties": {
        "gc_mode": { "type": "string" },
        "purged_legacy_refs": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "ListData": {
      "type": "object",
      "required": ["worktrees", "total_disk_saved", "total_files_hydrated"],
      "properties": {
        "worktrees": {
          "type": "array",
          "items": { "$ref": "#/definitions/WorktreeEntry" }
        },
        "total_disk_saved": { "type": "integer", "minimum": 0 },
        "total_files_hydrated": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "WorktreeEntry": {
      "type": "object",
      "required": [
        "path",
        "branch",
        "is_active",
        "is_main",
        "is_ephemeral",
        "files_hydrated",
        "bytes_hydrated",
        "bytes_saved"
      ],
      "properties": {
        "path": { "type": "string" },
        "branch": { "type": "string" },
        "head": { "type": "string" },
        "is_active": { "type": "boolean" },
        "is_main": { "type": "boolean" },
        "is_ephemeral": { "type": "boolean" },
        "files_hydrated": { "type": "integer", "minimum": 0 },
        "bytes_hydrated": { "type": "integer", "minimum": 0 },
        "bytes_saved": { "type": "integer", "minimum": 0 },
        "hydrated_dirs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "base_branch": { "type": "string" },
        "lease": { "$ref": "#/definitions/LeaseEntry" },
        "age_secs": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "LeaseEntry": {
      "type": "object",
      "required": [
        "lease_id",
        "pid",
        "pid_alive",
        "expires_at",
        "ttl_remaining_secs",
        "is_expired"
      ],
      "properties": {
        "lease_id": { "type": "string" },
        "pid": { "type": "integer", "minimum": 0 },
        "pid_alive": { "type": "boolean" },
        "expires_at": { "type": "integer", "minimum": 0 },
        "ttl_remaining_secs": { "type": "integer", "minimum": 0 },
        "is_expired": { "type": "boolean" },
        "worktree_path": { "type": "string" },
        "git_dir": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ScratchData": {
      "type": "object",
      "required": [
        "worktree_path",
        "branch",
        "lease_id",
        "lease_file",
        "expires_at",
        "files_hydrated",
        "hydration_method",
        "bytes_shared_cow",
        "bytes_copied",
        "duration_ms"
      ],
      "properties": {
        "worktree_path": { "type": "string" },
        "branch": { "type": "string" },
        "lease_id": { "type": "string" },
        "lease_file": { "type": "string" },
        "expires_at": { "type": "integer", "minimum": 0 },
        "files_hydrated": { "type": "integer", "minimum": 0 },
        "hydration_method": { "type": "string" },
        "bytes_shared_cow": { "type": "integer", "minimum": 0 },
        "bytes_copied": { "type": "integer", "minimum": 0 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "command": { "type": "string" },
        "exit_code": { "type": "integer" },
        "cleaned_up": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "DemoData": {
      "type": "object",
      "required": [
        "files_count",
        "total_bytes",
        "baseline_copy_duration_ms",
        "baseline_copy_bytes",
        "wt_hydration_duration_ms",
        "speedup_ratio",
        "hydration_method",
        "bytes_shared_cow",
        "bytes_copied",
        "space_savings_bytes",
        "isolation_verified",
        "cleaned_up",
        "total_duration_ms"
      ],
      "properties": {
        "files_count": { "type": "integer", "minimum": 0 },
        "total_bytes": { "type": "integer", "minimum": 0 },
        "baseline_copy_duration_ms": { "type": "integer", "minimum": 0 },
        "baseline_copy_bytes": { "type": "integer", "minimum": 0 },
        "wt_hydration_duration_ms": { "type": "integer", "minimum": 0 },
        "speedup_ratio": { "type": "number" },
        "hydration_method": { "type": "string" },
        "bytes_shared_cow": { "type": "integer", "minimum": 0 },
        "bytes_copied": { "type": "integer", "minimum": 0 },
        "space_savings_bytes": { "type": "integer", "minimum": 0 },
        "isolation_verified": { "type": "boolean" },
        "cleaned_up": { "type": "boolean" },
        "total_duration_ms": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "CleanData": {
      "type": "object",
      "required": [
        "removed_worktrees",
        "branches_removed",
        "references_released",
        "mirrors_removed",
        "reclaimed_bytes",
        "sweep_examined",
        "sweep_reclaimed"
      ],
      "properties": {
        "removed_worktrees": {
          "type": "array",
          "items": { "type": "string" }
        },
        "branches_removed": {
          "type": "array",
          "items": { "type": "string" }
        },
        "references_released": { "type": "integer", "minimum": 0 },
        "mirrors_removed": { "type": "integer", "minimum": 0 },
        "reclaimed_bytes": { "type": "integer", "minimum": 0 },
        "sweep_examined": { "type": "integer", "minimum": 0 },
        "sweep_reclaimed": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "LeaseData": {
      "type": "object",
      "required": ["leases"],
      "properties": {
        "leases": {
          "type": "array",
          "items": { "$ref": "#/definitions/LeaseEntry" }
        },
        "matched_lease": { "$ref": "#/definitions/LeaseEntry" }
      },
      "additionalProperties": false
    },
    "OperationReceipt": {
      "type": "object",
      "required": [
        "operation",
        "state",
        "timestamp",
        "source_root",
        "dest",
        "hydrated_dirs",
        "branch"
      ],
      "properties": {
        "operation": { "type": "string" },
        "state": {
          "type": "string",
          "enum": ["in_progress", "completed", "failed"]
        },
        "timestamp": { "type": "integer", "minimum": 0 },
        "source_root": { "type": "string" },
        "dest": { "type": "string" },
        "hydrated_dirs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "branch": { "type": "string" },
        "base": { "type": "string" },
        "pid": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "DoctorData": {
      "type": "object",
      "required": [
        "store_path",
        "env_vars",
        "fs_capabilities",
        "store_disk_usage"
      ],
      "properties": {
        "store_path": { "type": "string" },
        "env_vars": { "$ref": "#/definitions/DoctorEnvVars" },
        "fs_capabilities": { "$ref": "#/definitions/DoctorFsCapabilities" },
        "store_disk_usage": { "$ref": "#/definitions/StoreDuData" }
      },
      "additionalProperties": false
    },
    "DoctorEnvVars": {
      "type": "object",
      "properties": {
        "wt_store": { "type": "string" },
        "wt_snapshots": { "type": "string" },
        "wt_snapshots_v2": { "type": "string" },
        "wt_verify": { "type": "string" },
        "wt_timing": { "type": "string" },
        "wt_gc_grace": { "type": "string" },
        "wt_snapshot_cap": { "type": "string" },
        "wt_max_snapshot_bytes": { "type": "string" },
        "wt_hardlink": { "type": "string" },
        "wt_no_hardlink": { "type": "string" },
        "wt_tiny_bypass": { "type": "string" },
        "wt_no_tiny_bypass": { "type": "string" }
      },
      "additionalProperties": false
    },
    "DoctorFsCapabilities": {
      "type": "object",
      "required": [
        "apfs_clonefile",
        "ficlone",
        "copy_file_range"
      ],
      "properties": {
        "apfs_clonefile": { "type": "boolean" },
        "ficlone": { "type": "boolean" },
        "copy_file_range": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "StoreDuData": {
      "type": "object",
      "required": [
        "store_path",
        "objects_bytes",
        "snapshots_bytes",
        "mirrors_bytes",
        "refs_bytes",
        "caches_bytes",
        "total_bytes"
      ],
      "properties": {
        "store_path": { "type": "string" },
        "objects_bytes": { "type": "integer", "minimum": 0 },
        "snapshots_bytes": { "type": "integer", "minimum": 0 },
        "mirrors_bytes": { "type": "integer", "minimum": 0 },
        "refs_bytes": { "type": "integer", "minimum": 0 },
        "caches_bytes": { "type": "integer", "minimum": 0 },
        "total_bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
